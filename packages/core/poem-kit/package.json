{
  "name": "@poem/poem-kit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "诗词创作工具包 —— 目录懒加载、模板/变体查询、编辑器模式投影、草稿规范化",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@poem/parser": "workspace:*",
    "@poem/shared": "workspace:*"
  },
  "devDependencies": {
    "@poem/rhyme-book": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
