{
  "name": "@poem/parser",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "development": "./src/kernel.ts",
      "types": "./dist/kernel.d.ts",
      "default": "./dist/kernel.js"
    },
    "./types": {
      "development": "./src/core/types.ts",
      "types": "./dist/core/types.d.ts",
      "default": "./dist/core/types.js"
    },
    "./catalog": {
      "development": "./src/catalog.ts",
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    }
  },
  "scripts": {
    "clean:data": "node scripts/clean-data.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "examples": "pnpm build && node examples/run.mjs"
  },
  "dependencies": {
    "@poem/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
